# Haven Environment Variables
# Copy this file to .env and customize the values
# Docker Compose will automatically load .env when you run `docker compose up`

# Gateway Authentication
# IMPORTANT: Generate a secure random token: openssl rand -hex 32
AUTH_TOKEN=changeme

# Catalog Service Token (optional, for service-to-service auth)
CATALOG_TOKEN=

# Search Service Token (optional, for service-to-service auth)
SEARCH_TOKEN=

# OpenAI Configuration (optional, if using OpenAI for LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
LLM_PROVIDER=openai

# Ollama Configuration (default: uses host Ollama instance)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embedding Model
EMBEDDING_MODEL=bge-m3

# LLM Debug Mode
HAVEN_LLM_DEBUG=false

# MinIO Object Storage (change from defaults for production)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Worker Service Configuration
WORKER_TYPE=embedding
INTENT_MODEL=qwen2.5vl:3b
WORKER_POLL_INTERVAL=2.0
WORKER_BATCH_SIZE=16
INTENT_REQUEST_TIMEOUT=15.0
INTENT_MIN_CONFIDENCE=0.5
TAXONOMY_PATH=

# Catalog Service Configuration
CATALOG_FORWARD_TO_SEARCH=true
